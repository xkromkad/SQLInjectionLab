# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled, with ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Set to your production URL on Vercel (auto-detected locally).
# AUTH_URL="https://your-domain.com"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: https://your-domain.com/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Vercel Blob — for user-uploaded SQLite task databases (Phase 6)
BLOB_READ_WRITE_TOKEN=""

# Public site URL, used for SEO canonical/sitemap/OpenGraph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional analytics / ads (Phase 3). Leave empty to disable.
NEXT_PUBLIC_GTM_ID="G-PW3RL0WSNS"
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-3215849122189091"
